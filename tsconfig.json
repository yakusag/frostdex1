{
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "api/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "worker/**/*.ts",
    "scripts/**/*.ts",
    "build.ts",
    "vite.config.ts",
    "tailwind.config.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"]
    },

    // Vite takes care of building everything, not tsc.
    "noEmit": true
  }
}
